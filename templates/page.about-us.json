        "f5e88f1f-ff68-4d03-b686-0cb9fe62fab1": {
          "type": "text",
          "settings": {
            "title": "<h4 class=\"about__block-heading\">Rooted in Botanical Alchemy.<br> Proven by Modern Dermatological Science.</h4>\n<p class=\"about__block-subheading\">Formulating conscious, biocompatible skincare that nurtures the lipid barrier and respects the skin microbiome.</p>",
            "subheading": "",
            "text": "<p>KAYRA Beauty was founded on the conviction that true luxury lies in uncompromised purity and botanical potency. Our restorative elixirs combine cold-pressed botanicals with micro-fermented bio-actives to deliver transformative clinical results without irritating sensitive complexions. Every formula is sustainably harvested, cruelty-free, and formulated without synthetic fragrance, parabens, or mineral oils.</p>",
            "width": "100%",
            "alignment": "center",
            "align_text": "center",
            "text_size": "medium",
            "text_color": "black",
            "button_label": "",
            "button_link": "",
            "button_style": "m-button--primary",
            "button_size": "",
            "block_custom_class": "sf__about-block sf__about-block-text sf__about-block-text-1",
            "animations": "inherit"
          }
        },
        "4e1fb14f-ef60-4693-b6a2-2b26063e1b70": {
          "type": "image",
          "settings": {
