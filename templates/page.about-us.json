        "9a3a8077-de29-4141-9162-b9484d4a85f8": {
          "type": "html",
          "settings": {
            "code": "<div class=\"sf__about-custom-list\">\n  <h3>Our Botanical<br> Commitments.</h3>\n  <ul>\n    <li>\n      <span><svg class=\"m-svg-icon\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z\"/><path d=\"M12 6v6l4 2\"/></svg></span>\n      <div class=\"rte\">\n          <h4>Bio-Ferment Actives</h4>\n          <p class=\"text-color-subtext\">Nutrient bioavailability maximized through slow, sustainable fermentation.</p>\n      </div>\n    </li>\n    <li>\n      <span><svg class=\"m-svg-icon\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg></span>\n      <div class=\"rte\">\n          <h4>Lipid Barrier Protection</h4>\n          <p class=\"text-color-subtext\">Ceramides, squalane, and omegas that replenish what daily exposure depletes.</p>\n      </div>\n    </li>\n    <li>\n      <span><svg class=\"m-svg-icon\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg></span>\n      <div class=\"rte\">\n          <h4>100% Conscious Crafting</h4>\n          <p class=\"text-color-subtext\">Sustainable violet glass packaging, Leaping Bunny certified cruelty-free, and carbon-neutral shipping.</p>\n      </div>\n    </li>\n  </ul>\n</div>",
            "width": "50%",
            "block_custom_class": "sf__about-custom-html",
            "animations": "inherit"
          }
        },
        "28e3ce35-e364-43f3-ba87-18b633233063": {
          "type": "text",
          "settings": {
            "title": "<h4 class=\"about__block-heading\">Sustainable formulation without compromise.<br> For skin resilience and global biodiversity.</h4>",
            "subheading": "",
            "text": "<p>We work directly with ethical agricultural cooperatives across Japan, Madagascar, and Provence to source organic camellia seed oil, wild-crafted bakuchiol, and organic botanicals. Every batch is formulated in micro-lots to maintain unyielding active stability and sensory elegance.</p>",
            "width": "100%",
            "alignment": "center",
            "align_text": "center",
            "text_size": "medium",
            "text_color": "black",
            "button_label": "",
            "button_link": "",
            "button_style": "m-button--primary",
            "button_size": "",
            "block_custom_class": "sf__about-block sf__about-block-text sf__about-block-text-2",
            "animations": "inherit"
          }
        },
