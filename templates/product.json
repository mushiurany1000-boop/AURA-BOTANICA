{
  "sections": {
    "breadcrumb": {
      "type": "breadcrumb",
      "settings": {
        "container": "container",
        "text_alignment": "center",
        "hide_current": false,
        "hide_on_mb": false,
        "animations": "inherit"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "badge_tag": {
          "type": "badge",
          "settings": {}
        },
        "title_block": {
          "type": "title",
          "settings": {}
        },
        "rating_block": {
          "type": "rating",
          "settings": {}
        },
        "price_block": {
          "type": "price",
          "settings": {
            "show_saving": true,
            "sale_badge_type": "percentage"
          }
        },
        "variant_picker_block": {
          "type": "variant_picker",
          "settings": {
            "size_title": "Size/Volume"
          }
        },
        "buy_buttons_block": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_atc_button": true,
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust_badge_block": {
          "type": "trust_badge",
          "settings": {
            "trust_badges_text": "<p>100% Vegan ? Cruelty-Free ? Carbon-Neutral Shipping</p>",
            "trust_badges_image_width": "60%",
            "position": "below"
          }
        },
        "shipping_block": {
          "type": "shipping",
          "settings": {
            "show_delivery_times": true,
            "deliver_text": "Estimated Atelier Delivery:",
            "deliver_days": "3-5",
            "date_format": "%b %d",
            "show_shipping_text": true,
            "shipping_text": "<p><strong>Complimentary Cold-Chain Shipping: </strong>On domestic orders over .</p>"
          }
        },
        "addons_block": {
          "type": "addons",
          "settings": {
            "show_atcp": true,
            "show_ask_a_question": true,
            "show_social": true
          }
        }
      },
      "block_order": [
        "badge_tag",
        "title_block",
        "rating_block",
        "price_block",
        "variant_picker_block",
        "buy_buttons_block",
        "trust_badge_block",
        "shipping_block",
        "addons_block"
      ],
      "settings": {
        "container": "container",
        "layout": "layout-4",
        "show_atwl": true,
        "enable_history_state": true,
        "enable_variant_group_images": false,
        "disable_selected_variant_default": false,
        "show_featured_media": true,
        "show_zoom_button": true,
        "enable_video_autoplay": true,
        "show_nav_media_mobile": false,
        "show_pagination_mobile": true,
        "use_sticky_atc": true,
        "use_sticky_atc_on_mobile": true,
        "enable_dynamic_checkout": true,
        "sticky_atc_wishtlist": false,
        "sticky_atc_compare": false
      }
    },
    "product_details_tabs": {
      "type": "product-details-tabs",
      "blocks": {
        "desc_tab": {
          "type": "description",
          "settings": {
            "header": "Description"
          }
        },
        "tab_ingredients": {
          "type": "tab",
          "settings": {
            "header": "Full Ingredients (INCI)",
            "content": "<p>Camellia Sinensis Leaf Water, Squalane, Niacinamide, Sodium Hyaluronate, Bakuchiol, Hippophae Rhamnoides (Sea Buckthorn) Fruit Oil, Ceramide NP, Tocopherol (Vitamin E), Centella Asiatica Extract. Free of synthetic fragrance, sulfates, and parabens.</p>",
            "content_page": ""
          }
        },
        "tab_ritual": {
          "type": "tab",
          "settings": {
            "header": "How to Use (The Ritual)",
            "content": "<p>Dispense 3-4 drops into palms. Warm gently between hands and press into freshly cleansed, damp skin morning and evening. Follow with our Restorative Lipid Cream for optimal barrier sealing.</p>",
            "content_page": ""
          }
        },
        "tab_additional": {
          "type": "tab",
          "settings": {
            "header": "Additional Information",
            "content": "<p><strong>Skin Type: </strong>All skin types, including sensitive, reactive, and post-procedure skin.<br><strong>Volume: </strong>50ml / 1.7 fl. oz.<br><strong>Packaging: </strong>Biophotonic ultraviolet glass bottle with dropper dispenser.</p>",
            "content_page": ""
          }
        }
      },
      "block_order": [
        "desc_tab",
        "tab_ingredients",
        "tab_ritual",
        "tab_additional"
      ],
      "settings": {
        "container": "container",
        "color_scheme": "default",
        "default_open": true,
        "padding_top": 20,
        "padding_bottom": 50,
        "custom_class": "",
        "animations": "inherit"
      }
    },
    "product_reviews": {
      "type": "product-reviews",
      "settings": {
        "color_scheme": "default",
        "heading": "Customer Reviews",
        "container": "container",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "product_recommendations": {
      "type": "product-recommendations",
      "settings": {
        "container": "container-fluid",
        "color_scheme": "default",
        "remove_params": false,
        "heading": "Complete the Botanical Ritual",
        "heading_size": "h3",
        "text_align": "center",
        "limit": 4,
        "columns": 4,
        "column_gap": 30,
        "enable_slider": true,
        "use_scroll_mobile": true,
        "padding_top": 60,
        "padding_bottom": 60,
        "custom_class": "",
        "animations": "inherit"
      }
    },
    "recent_viewed_products": {
      "type": "recent-viewed-products",
      "settings": {
        "container": "container-fluid",
        "color_scheme": "default",
        "heading": "Recently Viewed Formulations",
        "heading_size": "h3",
        "text_align": "center",
        "limit": 4,
        "columns": 4,
        "column_gap": 30,
        "show_vendor": false,
        "hide_title": false,
        "enable_slider": true,
        "show_pagination": false,
        "show_navigation": false,
        "mobile_disable_slider": false,
        "use_scroll_mobile": true,
        "item_gap_mobile": 16,
        "padding_top": 0,
        "padding_bottom": 80,
        "custom_class": "",
        "animations": "inherit"
      }
    }
  },
  "order": [
    "breadcrumb",
    "main",
    "product_details_tabs",
    "product_reviews",
    "product_recommendations",
    "recent_viewed_products"
  ]
}
