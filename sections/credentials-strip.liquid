{%- comment -%}
  KAYRA Beauty v2.0 — Credentials Strip Section
  4-column luxury strip with thin hairline dividers matching Noir Velvet reference
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container | default: 'container'
  assign color_scheme = section.settings.color_scheme | default: 'default'
-%}

<section
  id="m-credentials-{{ section.id }}"
  class="m-section m-credentials bg-[#160408] border-t border-b border-[rgba(226,183,168,0.2)] text-[#FFF8F5] py-6 sm:py-8 m-color-{{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="credentials-strip"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 items-center">
      
      <!-- Col 1: Origin -->
      <div class="aura-hairline-col py-4 lg:py-0 px-4 sm:px-6 flex flex-col justify-center">
        <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#C5A59E] mb-1">
          {{ section.settings.col_1_label | default: 'ATELIER ORIGIN' }}
        </span>
        <span class="text-sm font-medium font-sans text-[#FFFFFF]">
          {{ section.settings.col_1_text | default: 'Bordeaux & Kyoto' }}
        </span>
      </div>

      <!-- Col 2: Formulation -->
      <div class="aura-hairline-col py-4 lg:py-0 px-4 sm:px-6 flex flex-col justify-center">
        <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#C5A59E] mb-1">
          {{ section.settings.col_2_label | default: 'FORMULATION' }}
        </span>
        <span class="text-sm font-medium font-sans text-[#FFFFFF]">
          {{ section.settings.col_2_text | default: '100% Clean & Biocompatible' }}
        </span>
      </div>

      <!-- Col 3: Signature -->
      <div class="aura-hairline-col py-4 lg:py-0 px-4 sm:px-6 flex items-center justify-start lg:justify-center">
        <span class="font-serif italic text-2xl text-[#E2B7A8] tracking-wider">
          {{ section.settings.col_3_signature | default: 'Kayra Atelier' }}
        </span>
      </div>

      <!-- Col 4: Promise -->
      <div class="aura-hairline-col py-4 lg:py-0 px-4 sm:px-6 flex flex-col justify-center">
        <span class="text-xs text-[#C5A59E] leading-relaxed font-sans">
          {{ section.settings.col_4_text | default: 'Transforming daily routines into restorative botanical rituals.' }}
        </span>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Credentials Strip",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Column 1 label",
      "default": "ATELIER ORIGIN"
    },
    {
      "type": "text",
      "id": "col_1_text",
      "label": "Column 1 text",
      "default": "Bordeaux & Kyoto"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Column 2 label",
      "default": "FORMULATION"
    },
    {
      "type": "text",
      "id": "col_2_text",
      "label": "Column 2 text",
      "default": "100% Clean & Biocompatible"
    },
    {
      "type": "header",
      "content": "Column 3 (Signature Script)"
    },
    {
      "type": "text",
      "id": "col_3_signature",
      "label": "Signature text",
      "default": "Kayra Atelier"
    },
    {
      "type": "header",
      "content": "Column 4"
    },
    {
      "type": "textarea",
      "id": "col_4_text",
      "label": "Column 4 promise",
      "default": "Transforming daily routines into restorative botanical rituals."
    }
  ],
  "presets": [
    {
      "name": "Credentials Strip"
    }
  ]
}
{% endschema %}

