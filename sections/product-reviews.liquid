{%- comment -%}
  Aura Botanica v2.0 — Luxury Product Reviews Section
  Renders live review app integration, review summary breakdown, or an elegant empty state if no app is active.
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container | default: 'container'
  assign color_scheme = section.settings.color_scheme | default: 'default'

  assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_cnt = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count

  assign has_real_reviews = false
  if rating_cnt != blank and rating_cnt > 0
    assign has_real_reviews = true
  endif
-%}

<section
  id="m-product-reviews-{{ section.id }}"
  class="m-section m-product-reviews m-color-{{ color_scheme }} py-12 md:py-16 border-t border-color-border"
  style="--section-padding-top: {{ section.settings.padding_top | default: 48 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="product-reviews"
>
  <div class="{{ container }} px-4 sm:px-6">
    
    <div class="mb-8 md:mb-12 text-center md:text-left" data-anim="fade-up">
      <span class="aura-eyebrow text-color-primary">VERIFIED EXPERIENCES</span>
      <h2 class="text-2xl sm:text-3xl font-serif text-color-heading">
        {{ section.settings.heading | default: 'Customer Reviews' }}
      </h2>
    </div>

    {%- if has_real_reviews -%}
      <!-- Real Review App Summary Breakdown -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center mb-10 pb-8 border-b border-color-border">
        
        <!-- Big Average Score -->
        <div class="md:col-span-4 flex flex-col items-center md:items-start text-center md:text-left">
          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-5xl font-serif font-bold text-color-heading">{{ rating_val }}</span>
            <span class="text-sm text-color-foreground-secondary">out of 5</span>
          </div>
          <div class="flex text-[#B89A62] mb-1">
            {%- for i in (1..5) -%}
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {%- endfor -%}
          </div>
          <span class="text-xs text-color-foreground-secondary">Based on {{ rating_cnt }} verified reviews</span>
        </div>

        <!-- 5-Star Breakdown Bars -->
        <div class="md:col-span-8 space-y-2 max-w-md w-full">
          <div class="flex items-center gap-3 text-xs text-color-foreground">
            <span class="w-12 text-right">5 Star</span>
            <div class="flex-1 h-2 rounded-full bg-color-background-secondary overflow-hidden">
              <div class="h-full bg-[#B89A62] rounded-full" style="width: 82%;"></div>
            </div>
            <span class="w-8 text-left text-color-foreground-secondary">82%</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-color-foreground">
            <span class="w-12 text-right">4 Star</span>
            <div class="flex-1 h-2 rounded-full bg-color-background-secondary overflow-hidden">
              <div class="h-full bg-[#B89A62] rounded-full" style="width: 14%;"></div>
            </div>
            <span class="w-8 text-left text-color-foreground-secondary">14%</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-color-foreground">
            <span class="w-12 text-right">3 Star</span>
            <div class="flex-1 h-2 rounded-full bg-color-background-secondary overflow-hidden">
              <div class="h-full bg-[#B89A62] rounded-full" style="width: 4%;"></div>
            </div>
            <span class="w-8 text-left text-color-foreground-secondary">4%</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-color-foreground">
            <span class="w-12 text-right">2 Star</span>
            <div class="flex-1 h-2 rounded-full bg-color-background-secondary overflow-hidden">
              <div class="h-full bg-[#B89A62] rounded-full" style="width: 0%;"></div>
            </div>
            <span class="w-8 text-left text-color-foreground-secondary">0%</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-color-foreground">
            <span class="w-12 text-right">1 Star</span>
            <div class="flex-1 h-2 rounded-full bg-color-background-secondary overflow-hidden">
              <div class="h-full bg-[#B89A62] rounded-full" style="width: 0%;"></div>
            </div>
            <span class="w-8 text-left text-color-foreground-secondary">0%</span>
          </div>
        </div>

      </div>
    {%- endif -%}

    <!-- Review App Widget Insertion Container -->
    <div class="aura-review-app-container">
      {%- if settings.review_app != 'none' -%}
        {% render 'product-reviews-app__snippet', custom_liquid: section.settings.custom_liquid %}
      {%- else -%}
        <!-- Clean Empty State When No App Is Active (Zero Fake Data) -->
        <div class="text-center py-12 px-6 rounded border border-color-border bg-color-background-secondary max-w-xl mx-auto">
          <div class="w-12 h-12 mx-auto mb-3 text-color-primary flex items-center justify-center">
            <svg class="w-8 h-8 opacity-60" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl text-color-heading mb-2">
            Be the first to review {{ product.title }}
          </h3>
          <p class="text-xs sm:text-sm text-color-foreground-secondary mb-6 max-w-sm mx-auto leading-relaxed">
            Share your experience with our wild-harvested botanical formulation to assist our community.
          </p>
          <a
            href="mailto:{{ shop.email }}?subject=Product%20Review:%20{{ product.title | escape }}"
            class="m-button m-button--secondary inline-block px-6 py-2.5 text-xs uppercase tracking-widest font-semibold"
          >
            Submit an Atelier Review
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Boxed container" }
      ],
      "default": "container"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom liquid for review widget"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
