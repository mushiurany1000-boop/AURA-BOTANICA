{%- comment -%}
  KAYRA Beauty v2.0 — Luxury Benefits Strip Section
  Phase 12 Exact Replica of Reference Design (Full-Width Rust Band #7C2E21,
  4 Equal Columns with 1px Hairline Dividers, Elegant Minimalist Icons, Jost Small-Caps).
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-benefits-strip-' | append: section.id
  assign color_scheme = section.settings.color_scheme | default: 'scheme-clay-rose'
  assign bg_custom = section.settings.bg_color | default: '#7C2E21'
  assign text_custom = section.settings.text_color | default: '#FCE8E7'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-benefits-strip relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 28 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 28 }}px; background-color: {{ bg_custom }}; color: {{ text_custom }};"
  data-section-id="{{ section.id }}"
  data-section-type="benefits-strip"
>
  <div class="w-full px-4 sm:px-8 lg:px-12 py-7 md:py-9">
    <div
      class="grid grid-cols-2 lg:grid-cols-4 items-stretch"
      data-anim="stagger-children"
      data-anim-stagger="0.08"
    >
      {%- for block in section.blocks -%}
        <div
          class="m-benefits-strip__col flex flex-col items-center justify-center text-center px-3 sm:px-6 py-4 sm:py-6 relative group transition-colors duration-300 {% unless forloop.last %}lg:border-r lg:border-white/20{% endunless %} {% if forloop.index == 1 or forloop.index == 2 %}border-b border-white/20 lg:border-b-0 pb-6 lg:pb-6{% endif %} {% if forloop.index == 1 or forloop.index == 3 %}border-r border-white/20 lg:border-r-0{% endif %}"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <!-- Fine-Line Minimalist Icon Display -->
          <div class="w-8 h-8 sm:w-10 sm:h-10 mb-2.5 sm:mb-3 flex items-center justify-center text-current opacity-95 transition-transform duration-300 group-hover:scale-110">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'w-full h-full object-contain' }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'shopping-bag' -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                  </svg>
                {%- when 'mortar-pestle' -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <!-- Pestle -->
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.5 5.5l-6 6"/>
                    <circle cx="18" cy="5" r="1.5" fill="none" stroke="currentColor" stroke-width="1.25"/>
                    <!-- Mortar Bowl -->
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15c0 4.5-3.5 8-7.5 8s-7.5-3.5-7.5-8z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 12h17"/>
                  </svg>
                {%- when 'leaf' -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 4.5c-7 0-14 4-15 15 11 1 15-8 15-15z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5c4-4 8-7 15-15"/>
                  </svg>
                {%- when 'skin-quiz' -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <!-- Continuous line female face profile -->
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 4.5c-3 0-5.5 1.5-6.5 4C9 9.5 8 10 7 10c-1 0-1.5.5-1.5 1.5s.5 1.5 1.5 2c.5.25.75.75.75 1.5 0 2 1.5 4 4 4.5 2 .4 4-.5 5.25-2"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 11.5a1 1 0 100-2 1 1 0 000 2z"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                {%- else -%}
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.25" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          <!-- Small-Caps Label -->
          {%- if block.settings.label != blank -%}
            <span class="aura-eyebrow mb-1 font-semibold tracking-[0.20em] text-[11px] sm:text-xs uppercase text-white">
              {{ block.settings.label }}
            </span>
          {%- endif -%}

          <!-- 2-Line Subtitle Description -->
          {%- if block.settings.text != blank -%}
            <p class="text-[11px] sm:text-xs text-current opacity-90 max-w-[200px] leading-snug font-normal">
              {{ block.settings.text }}
            </p>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="absolute inset-0 z-10" aria-label="{{ block.settings.label | default: 'Learn more' }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits strip",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-clay-rose"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "default": "#7C2E21"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text/icon color",
      "default": "#FCE8E7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "shopping-bag", "label": "Shopping bag" },
            { "value": "mortar-pestle", "label": "Mortar & pestle / Ritual" },
            { "value": "leaf", "label": "Botanical leaf / Ingredients" },
            { "value": "skin-quiz", "label": "Profile / Skin quiz" },
            { "value": "shield", "label": "Shield / Clean guarantee" }
          ],
          "default": "shopping-bag"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image (optional)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small-caps label",
          "default": "SHOP"
        },
        {
          "type": "text",
          "id": "text",
          "label": "2-line subtext",
          "default": "Curated essentials for every skin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits strip",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shopping-bag",
            "label": "SHOP",
            "text": "Curated essentials for every skin"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "mortar-pestle",
            "label": "RITUAL",
            "text": "Simple steps. Lasting results."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "label": "INGREDIENTS",
            "text": "Transparent. Purposeful. Clean."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "skin-quiz",
            "label": "SKIN QUIZ",
            "text": "Find your routine in minutes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
