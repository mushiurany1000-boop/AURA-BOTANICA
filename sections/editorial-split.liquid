{%- liquid
  assign section_id = 'm-editorial-split-' | append: section.id
-%}
<div id="{{ section_id }}" class="m-section m-editorial-split py-16" style="background-color: {{ section.settings.bg_color }};">
  <div class="{{ section.settings.container }}">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="order-2 {% if section.settings.image_position == 'left' %}lg:order-2{% else %}lg:order-1{% endif %}">
        {%- if section.settings.subheading != blank -%}
          <span class="text-xs uppercase tracking-widest text-[#B9784D] block mb-2 font-medium">{{ section.settings.subheading }}</span>
        {%- endif -%}
        <h2 class="text-3xl md:text-5xl font-serif text-[#18231F] mb-6 leading-tight">{{ section.settings.heading }}</h2>
        <div class="text-[#5C6B61] text-base leading-relaxed mb-8">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="m-button m-button--primary inline-block">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="order-1 {% if section.settings.image_position == 'left' %}lg:order-1{% else %}lg:order-2{% endif %} rounded-2xl overflow-hidden aspect-[4/5] bg-neutral-200">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover' }}
        {%- else -%}
          <div class="w-full h-full bg-[#18231F] flex items-center justify-center p-8 text-center text-[#FCFBF7] font-serif text-2xl">Editorial Botanical Ritual</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pure Formulation Alchemy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grounded in Botany, Proven by Clinical Science" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Aura Botanica exists at the confluence of ancient herbal wisdom and advanced biotechnological synthesis. Our formulations nourish lipid integrity and promote radiant skin vitality.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover Our Philosophy" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Container box" }
      ],
      "default": "container"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FCFBF7" }
  ],
  "presets": [
    { "name": "Editorial split" }
  ]
}
{% endschema %}

