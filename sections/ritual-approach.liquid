{%- comment -%}
  KAYRA Beauty v2.0 — 5-Step Ritual / Approach Section
  5 equal numbered vertical columns with thin hairline dividers matching Noir Velvet reference
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container | default: 'container'
  assign color_scheme = section.settings.color_scheme | default: 'default'
-%}

<section
  id="m-approach-{{ section.id }}"
  class="m-section m-approach py-16 md:py-24 bg-[#180509] text-[#FFF8F5] m-color-{{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="ritual-approach"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-10 pb-3 border-b border-[rgba(226,183,168,0.2)]" data-anim="fade-up">
      <div class="aura-eyebrow-plus text-xs font-semibold uppercase tracking-[0.22em] text-[#E2B7A8]">
        + {{ section.settings.heading | default: 'MY APPROACH' }}
      </div>
    </div>

    <!-- 5 Columns Container with Hairline Dividers -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border-t border-b lg:border-t-0 lg:border-b-0 border-[rgba(226,183,168,0.2)]" data-anim="stagger-children" data-anim-stagger="0.08">
      {%- for block in section.blocks -%}
        <div class="aura-approach-step" data-anim-child {{ block.shopify_attributes }}>
          
          <!-- Icon Top -->
          <div class="w-10 h-10 mb-8 text-[#E2B7A8] flex items-center justify-start">
            {%- case forloop.index -%}
              {%- when 1 -%}
                <svg class="w-8 h-8 stroke-current stroke-[1.4]" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              {%- when 2 -%}
                <svg class="w-8 h-8 stroke-current stroke-[1.4]" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              {%- when 3 -%}
                <svg class="w-8 h-8 stroke-current stroke-[1.4]" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
              {%- when 4 -%}
              <svg class="w-8 h-8 stroke-current stroke-[1.4]" viewBox="0 0 24 24" fill="none"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              {%- else -%}
                <svg class="w-8 h-8 stroke-current stroke-[1.4]" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- endcase -%}
          </div>

          <!-- Step Number & Title -->
          <div>
            <div class="text-[11px] font-semibold text-[#E2B7A8] tracking-[0.2em] mb-1 font-mono">
              0{{ forloop.index }}
            </div>
            <h4 class="text-sm font-semibold uppercase tracking-[0.14em] text-[#FFFFFF] mb-3 font-sans">
              {{ block.settings.title }}
            </h4>
            <p class="text-xs text-[#C5A59E] leading-relaxed font-sans">
              {{ block.settings.text }}
            </p>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "5-Step Approach / Ritual",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section header text",
      "default": "MY APPROACH"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "DISCOVER"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description",
          "default": "I dive deep into your skin goals, reactive triggers, and barrier challenges."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5-Step Approach / Ritual",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "DISCOVER",
            "text": "I dive deep into your skin goals, reactive triggers, and barrier challenges."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "DEFINE",
            "text": "I craft bespoke botanical formulations with biocompatible lipid architectures."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "DESIGN",
            "text": "Cold-pressed actives that are clean, restorative, and clinically pure."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "BUILD",
            "text": "Micro-dosed active delivery ensuring peak dermal penetration."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "REFINE",
            "text": "Barrier testing and continuous optimization for lasting skin vitality."
          }
        }
      ]
    }
  ]
}
{% endschema %}

