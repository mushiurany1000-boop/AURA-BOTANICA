{%- comment -%}
  Aura Botanica v2.0 — Luxury Subscribe & Save Banner Section
  Full-width subscription and refill replenishment banner with unboxing media and flexible delivery CTA.
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-subscribe-banner-' | append: section.id
  assign color_scheme = section.settings.color_scheme | default: 'scheme-clay-rose'
  assign container = section.settings.container | default: 'container'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-subscribe-banner m-color-{{ color_scheme }} py-12 md:py-16 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 48 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="subscribe-save-banner"
>
  <div class="{{ container }} px-4 sm:px-6">
    <div
      class="aura-card-luxury p-6 sm:p-10 lg:p-14 flex flex-col lg:flex-row items-center justify-between gap-8 md:gap-12 relative overflow-hidden"
      data-anim="fade-up"
    >
      
      <!-- Left Media Area: Unboxing Package -->
      <div class="w-full lg:w-5/12 aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3] relative rounded overflow-hidden group">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: 
            loading: 'lazy', 
            class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105',
            data-anim: 'parallax',
            data-anim-speed: '0.05'
          }}
        {%- else -%}
          <div class="w-full h-full bg-color-background flex flex-col items-center justify-center p-6 text-center border border-color-border">
            <svg class="w-12 h-12 text-color-primary-accent opacity-50 mb-3" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <span class="font-serif text-lg text-color-heading mb-1">Sustainable Apothecary Unboxing</span>
            <span class="text-xs text-color-foreground-secondary">100% Recyclable Glass & Cold-Chain Shipping</span>
          </div>
        {%- endif -%}
      </div>

      <!-- Right Content Area -->
      <div class="w-full lg:w-7/12 flex flex-col items-start text-left lg:pl-6">
        {%- if section.settings.eyebrow != blank -%}
          <span class="aura-eyebrow text-color-primary mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-serif text-color-heading mb-4 leading-tight">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="text-sm sm:text-base text-color-foreground opacity-90 leading-relaxed mb-6 max-w-lg">
            {{ section.settings.text }}
          </p>
        {%- endif -%}

        <!-- Features Row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8 w-full max-w-lg text-xs sm:text-sm text-color-heading font-medium">
          <div class="flex items-center gap-2">
            <span class="text-color-primary font-bold">&check;</span>
            <span>Save 15% on Every Order</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-color-primary font-bold">&check;</span>
            <span>Pause or Cancel Anytime</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-color-primary font-bold">&check;</span>
            <span>Complimentary Shipping</span>
          </div>
        </div>

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="m-button m-button--primary px-8 py-3 text-xs uppercase tracking-widest font-semibold"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscribe & save banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-clay-rose"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Boxed container" }
      ],
      "default": "container"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Unboxing / Replenishment photo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "NEVER RUN LOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe & stay effortlessly consistent"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext description",
      "default": "Flexible delivery schedules. Guaranteed freshly compounded formulations. Pause, skip, or cancel anytime with one click."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Subscribe & save banner"
    }
  ]
}
{% endschema %}

