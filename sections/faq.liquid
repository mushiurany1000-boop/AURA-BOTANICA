{%- comment -%}
  KAYRA Beauty v2.0 — Luxury Two-Column FAQ Section
  Two-column accordion with GSAP height animation, accessible triggers, and FAQPage structured data.
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-faq-' | append: section.id
  assign color_scheme = section.settings.color_scheme | default: 'default'
  assign container = section.settings.container | default: 'container'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-faq m-color-{{ color_scheme }} py-12 md:py-20 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 48 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px; background-color: {{ section.settings.bg_color | default: 'transparent' }};"
  data-section-id="{{ section.id }}"
  data-section-type="faq"
>
  <div class="{{ container }} px-4 sm:px-6">
    
    <!-- Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 md:mb-12 gap-4" data-anim="fade-up">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="aura-eyebrow text-color-primary">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-color-heading tracking-tight">
          {{ section.settings.heading | default: 'Frequently Asked Questions' }}
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="text-sm text-color-foreground-secondary mt-2 max-w-xl leading-relaxed">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <a
          href="{{ section.settings.view_all_link | default: '/pages/faqs' }}"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm uppercase tracking-wider font-semibold text-color-primary hover:text-color-heading transition-colors group flex-shrink-0"
        >
          {{ section.settings.view_all_label | default: 'View all FAQs' }}
          <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <!-- 2-Column Accordion Grid on Desktop, Single Column on Mobile -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-2 items-start"
      data-anim="stagger-children"
      data-anim-stagger="0.06"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_id = 'faq-item-' | append: section.id | append: '-' | append: forloop.index
          assign panel_id = 'faq-panel-' | append: section.id | append: '-' | append: forloop.index
        -%}
        <div
          class="aura-faq-accordion-item border-b border-color-border py-1"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="aura-faq-accordion-header group flex items-center justify-between w-full py-4 text-left cursor-pointer focus:outline-none"
            aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}"
            aria-controls="{{ panel_id }}"
            id="{{ item_id }}"
            onclick="toggleAuraFaq(this)"
          >
            <span class="text-base sm:text-lg font-serif text-color-heading group-hover:text-color-primary transition-colors pr-4">
              {{ block.settings.question }}
            </span>
            <span class="w-6 h-6 flex items-center justify-center text-color-primary font-light text-xl leading-none flex-shrink-0 transition-transform duration-300 aura-faq-icon">
              {% if block.settings.open %}&minus;{% else %}&plus;{% endif %}
            </span>
          </button>

          <div
            id="{{ panel_id }}"
            role="region"
            aria-labelledby="{{ item_id }}"
            class="aura-faq-accordion-body text-xs sm:text-sm text-color-foreground opacity-90 leading-relaxed pb-4 {% unless block.settings.open %}hidden{% endunless %}"
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<!-- Accessible Accordion Handler -->
<script>
  function toggleAuraFaq(button) {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    const panelId = button.getAttribute('aria-controls');
    const panel = document.getElementById(panelId);
    const icon = button.querySelector('.aura-faq-icon');

    if (!panel) return;

    if (isExpanded) {
      button.setAttribute('aria-expanded', 'false');
      panel.classList.add('hidden');
      if (icon) icon.innerHTML = '&plus;';
    } else {
      button.setAttribute('aria-expanded', 'true');
      panel.classList.remove('hidden');
      if (icon) icon.innerHTML = '&minus;';

      if (window.gsap) {
        window.gsap.fromTo(panel, 
          { opacity: 0, height: 0 }, 
          { opacity: 1, height: 'auto', duration: 0.35, ease: 'power2.out' }
        );
      }
    }
  }
</script>

<!-- FAQ Structured Data (Schema.org/FAQPage) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FREQUENTLY ASKED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulation Inquiries"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Clear answers regarding our clean clinical extraction standards and biocompatible ingredients."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all FAQs' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Boxed container" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Legacy background color fallback",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products suitable for sensitive skin?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Every KAYRA Beauty formulation is biocompatible, hypoallergenic, and formulated without synthetic fragrance or aggressive surfactants.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Default open",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Are your products suitable for sensitive skin?",
            "answer": "<p>Yes. Every formulation is crafted with bio-calming actives designed to soothe reactive barriers.</p>",
            "open": true
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How do I build a routine?",
            "answer": "<p>Start with our 3-step fundamental ritual: Cleanser, Barrier Elixir, and Lipid Cream.</p>",
            "open": false
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What makes your ingredients clean?",
            "answer": "<p>We source only wild-harvested botanicals cold-pressed to preserve cellular bio-potency.</p>",
            "open": false
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>We offer carbon-neutral domestic and international shipping with temperature-controlled packaging.</p>",
            "open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
