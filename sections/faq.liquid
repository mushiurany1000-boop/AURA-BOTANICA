{%- comment -%}
  Aura Botanica v2.0 — Luxury Two-Column FAQ Section
  Phase 12 Exact Replica of Reference Design:
  - Header: FREQUENTLY ASKED (left) / View all FAQs → (right)
  - 2-Column Desktop Grid with 1px Outlined Rows (Height ~46px, '+' Toggle)
  - Default 4 Questions from Reference Mockup
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-faq-' | append: section.id
  assign container = section.settings.container | default: 'container'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-faq py-8 md:py-12 lg:py-14 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 32 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="faq"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    
    <!-- Header Row (Matching Reference 1: Left Eyebrow / Right Link) -->
    <div class="flex flex-row items-center justify-between mb-6 pb-2 border-b border-[#E9D5CC]/40" data-anim="fade-up">
      <div>
        <h2 class="aura-eyebrow text-[#5E1E16] text-xs sm:text-sm font-semibold tracking-[0.20em] uppercase">
          {{ section.settings.subheading | default: 'FREQUENTLY ASKED' }}
        </h2>
      </div>

      {%- if section.settings.show_view_all -%}
        <a
          href="{{ section.settings.view_all_link | default: '/pages/faqs' }}"
          class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.14em] font-semibold text-[#5E1E16] hover:text-[#8B3224] transition-colors group"
        >
          {{ section.settings.view_all_label | default: 'View all FAQs' }}
          <span class="transition-transform duration-300 group-hover:translate-x-1 font-sans">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <!-- 2-Column Accordion Grid (2x2 on Desktop, Single Column on Mobile) -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-3 lg:gap-4 items-start"
      data-anim="stagger-children"
      data-anim-stagger="0.05"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_id = 'faq-item-' | append: section.id | append: '-' | append: forloop.index
          assign panel_id = 'faq-panel-' | append: section.id | append: '-' | append: forloop.index
        -%}
        <div
          class="aura-faq-row border border-[#E9D5CC] bg-[#FDFBF9] rounded-none px-4 sm:px-5 py-2.5 transition-colors duration-200 hover:border-[#8B3224]/50"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="aura-faq-accordion-header group flex items-center justify-between w-full py-1 text-left cursor-pointer focus:outline-none"
            aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}"
            aria-controls="{{ panel_id }}"
            id="{{ item_id }}"
            onclick="toggleAuraFaq(this)"
          >
            <span class="text-xs sm:text-[13px] font-sans text-[#3B1E18] font-normal pr-3 leading-snug group-hover:text-[#8B3224] transition-colors">
              {{ block.settings.question }}
            </span>
            <span class="w-5 h-5 flex items-center justify-center text-[#6A625F] group-hover:text-[#8B3224] font-light text-base leading-none flex-shrink-0 transition-transform duration-200 aura-faq-icon">
              {% if block.settings.open %}&minus;{% else %}&plus;{% endif %}
            </span>
          </button>

          <div
            id="{{ panel_id }}"
            role="region"
            aria-labelledby="{{ item_id }}"
            class="aura-faq-accordion-body text-xs text-[#6A625F] leading-relaxed pt-2 pb-1 {% unless block.settings.open %}hidden{% endunless %}"
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<!-- Accessible Accordion Handler -->
<script>
  function toggleAuraFaq(button) {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    const panelId = button.getAttribute('aria-controls');
    const panel = document.getElementById(panelId);
    const icon = button.querySelector('.aura-faq-icon');

    if (isExpanded) {
      button.setAttribute('aria-expanded', 'false');
      panel.classList.add('hidden');
      if (icon) icon.innerHTML = '&plus;';
    } else {
      button.setAttribute('aria-expanded', 'true');
      panel.classList.remove('hidden');
      if (icon) icon.innerHTML = '&minus;';
    }
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Section eyebrow",
      "default": "FREQUENTLY ASKED"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container", "label": "Boxed container (Recommended)" },
        { "value": "container-fluid", "label": "Full width" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products suitable for sensitive skin?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Every formulation is dermatologist tested, hypoallergenic, and crafted without fragrance or synthetic irritants for sensitive barrier support.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Are your products suitable for sensitive skin?",
            "answer": "<p>Yes. Every formulation is dermatologist tested, hypoallergenic, and crafted without fragrance or synthetic irritants for sensitive barrier support.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How do I build a routine?",
            "answer": "<p>Start with a gentle cleanser, apply your target active serum to damp skin, lock in hydration with moisturizer, and finish with SPF each morning.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What makes your ingredients clean?",
            "answer": "<p>We adhere to strict biocompatibility standards, wild-harvesting sustainably and avoiding parabens, sulfates, silicones, and artificial dyes.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>We offer carbon-neutral shipping worldwide. Orders over $75 include complimentary delivery and deluxe botanical travel samples.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
