{%- comment -%}
  KAYRA Beauty v2.0 — Shop by Category Section
  Phase 12 Exact Replica of Reference Design (Side-by-Side Category Cards,
  Cutout Product Images Left, Category Title + 2-Line Subtext + Arrow Right, Flat Blush #F3E8E2).
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-collection-list-' | append: section.id
  assign color_scheme = section.settings.color_scheme | default: 'default'
  assign container = section.settings.container | default: 'container'
  assign cols_desktop = section.settings.columns_desktop | default: 4
  assign card_bg = section.settings.card_bg_color | default: '#F3E8E2'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-collection-list m-color-{{ color_scheme }} py-12 md:py-16 lg:py-20 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 60 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px; background-color: {{ section.settings.bg_color | default: 'transparent' }};"
  data-section-id="{{ section.id }}"
  data-section-type="collection-list"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header Row (Matching Reference: Left Eyebrow / Right Link) -->
    <div class="flex flex-row items-center justify-between mb-6 md:mb-8 pb-1 border-b border-[#E9D5CC]/40" data-anim="fade-up">
      <div>
        <h2 class="aura-eyebrow text-[#5E1E16] text-xs sm:text-sm font-semibold tracking-[0.20em] uppercase">
          {{ section.settings.subheading | default: 'SHOP BY CATEGORY' }}
        </h2>
      </div>

      {%- if section.settings.show_view_all -%}
        <a
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          class="inline-flex items-center gap-1.5 text-xs sm:text-xs uppercase tracking-[0.14em] font-semibold text-[#5E1E16] hover:text-[#8B3224] transition-colors group"
        >
          {{ section.settings.view_all_label | default: 'View all products' }}
          <span class="transition-transform duration-300 group-hover:translate-x-1 font-sans">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Category Grid / Mobile Scroll-Snap Carousel -->
    <div
      class="flex overflow-x-auto pb-4 pt-1 sm:pb-0 sm:pt-0 snap-x snap-mandatory lg:grid lg:grid-cols-{{ cols_desktop }} gap-3 sm:gap-4 lg:gap-5 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar"
      data-anim="stagger-children"
      data-anim-stagger="0.08"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign card_title = block.settings.title | default: col.title | default: 'Category'
          assign card_desc = block.settings.text | default: 'Botanical Formulations'
          assign card_link = block.settings.link | default: col.url | default: routes.all_products_collection_url
          assign card_img = block.settings.image | default: col.featured_image
          assign mod_idx = forloop.index0 | modulo: 4
        -%}
        <div
          class="flex-shrink-0 w-[240px] sm:w-[270px] lg:w-auto snap-start"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ card_link }}"
            class="aura-category-card--replica group h-full flex flex-row items-center justify-between p-3.5 sm:p-4 lg:p-5 text-left transition-all duration-300 relative overflow-hidden"
            style="background-color: {{ card_bg }};"
          >
            <!-- Product Cutout Area (Left Side in Reference) -->
            <div class="w-[42%] flex-shrink-0 flex items-center justify-center h-[130px] sm:h-[150px] relative overflow-hidden pr-2">
              {%- if card_img != blank -%}
                {{ card_img | image_url: width: 400 | image_tag: 
                  loading: 'lazy', 
                  class: 'max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105' 
                }}
              {%- else -%}
                <!-- Refined Botanical Silhouette Matching Reference 4 Categories -->
                {%- case mod_idx -%}
                  {%- when 0 -%}
                    <!-- 1. Cleanser Tall Bottle with Pump -->
                    <svg class="h-[120px] w-auto transition-transform duration-500 group-hover:scale-105" viewBox="0 0 60 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Cleanser">
                      <!-- Bottle -->
                      <rect x="12" y="38" width="36" height="74" rx="4" fill="#FFFFFF" stroke="#E0CFC6" stroke-width="1"/>
                      <rect x="16" y="44" width="28" height="30" rx="1" fill="#F7EFEA"/>
                      <!-- Pump -->
                      <rect x="25" y="28" width="10" height="10" rx="1" fill="#C5856E"/>
                      <path d="M30 28 L30 18 L20 20 C18 20 18 16 20 16 L35 14 C37 14 38 16 38 18 L38 28 Z" fill="#C5856E"/>
                    </svg>
                  {%- when 1 -%}
                    <!-- 2. Serum Dropper Bottle -->
                    <svg class="h-[120px] w-auto transition-transform duration-500 group-hover:scale-105" viewBox="0 0 60 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Serum">
                      <!-- Glass Bottle -->
                      <rect x="15" y="45" width="30" height="66" rx="5" fill="#F5C4B3" fill-opacity="0.85" stroke="#E0AFA0" stroke-width="1"/>
                      <rect x="19" y="52" width="22" height="28" rx="1" fill="#FFFFFF" fill-opacity="0.7"/>
                      <!-- Pipette Cap -->
                      <rect x="22" y="35" width="16" height="10" rx="1" fill="#C5856E"/>
                      <path d="M26 35 C26 22 34 22 34 35 Z" fill="#FFFFFF" stroke="#EADBD4" stroke-width="0.8"/>
                    </svg>
                  {%- when 2 -%}
                    <!-- 3. Moisturizer Cream Jar -->
                    <svg class="h-[120px] w-auto transition-transform duration-500 group-hover:scale-105" viewBox="0 0 80 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Moisturizer">
                      <!-- Cream Jar -->
                      <rect x="10" y="58" width="60" height="48" rx="6" fill="#FFFFFF" stroke="#E0CFC6" stroke-width="1"/>
                      <rect x="8" y="46" width="64" height="14" rx="3" fill="#C5856E"/>
                      <line x1="8" y1="59" x2="72" y2="59" stroke="#9E5B45" stroke-width="1"/>
                    </svg>
                  {%- else -%}
                    <!-- 4. Sun Care Tube -->
                    <svg class="h-[120px] w-auto transition-transform duration-500 group-hover:scale-105" viewBox="0 0 60 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Sun Care">
                      <!-- Squeeze Tube -->
                      <path d="M14 26 L46 26 L42 88 L18 88 Z" fill="#FFFFFF" stroke="#E0CFC6" stroke-width="1"/>
                      <rect x="18" y="88" width="24" height="16" rx="2" fill="#C5856E"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            <!-- Card Label & Subtext (Right Side in Reference) -->
            <div class="w-[58%] pl-2 sm:pl-3 flex flex-col justify-center items-start">
              <h3 class="aura-eyebrow text-[#3B1E18] mb-1 text-xs sm:text-[13px] font-semibold tracking-[0.18em] uppercase">
                {{ card_title }}
              </h3>
              <p class="text-[11px] sm:text-xs text-[#6A625F] mb-3 leading-snug font-normal">
                {{ card_desc }}
              </p>
              <span class="aura-category-arrow inline-flex items-center text-[#5E1E16] text-xs font-semibold">
                &rarr;
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section eyebrow",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "Curated Botanical Categories"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#F3E8E2"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container", "label": "Boxed container (Recommended)" },
        { "value": "container-fluid", "label": "Full width" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom product cutout image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "CLEANSERS"
        },
        {
          "type": "text",
          "id": "text",
          "label": "2-line subtext",
          "default": "Purify & refresh"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "CLEANSERS",
            "text": "Purify & refresh"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "SERUMS",
            "text": "Treat & transform"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "MOISTURIZERS",
            "text": "Nourish & protect"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "SUN CARE",
            "text": "Shield & care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
