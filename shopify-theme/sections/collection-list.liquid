{%- comment -%}
  KAYRA Beauty v2.0 — Shop by Category Section
  4 soft-tinted editorial category cards with product cutout image, label, subtext, and hover lift.
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-collection-list-' | append: section.id
  assign color_scheme = section.settings.color_scheme | default: 'default'
  assign container = section.settings.container | default: 'container'
  assign cols_desktop = section.settings.columns_desktop | default: 4
-%}

<section
  id="{{ section_id }}"
  class="m-section m-collection-list m-color-{{ color_scheme }} py-12 md:py-20 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 48 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px; background-color: {{ section.settings.bg_color | default: 'transparent' }};"
  data-section-id="{{ section.id }}"
  data-section-type="collection-list"
>
  <div class="{{ container }} px-4 sm:px-6">
    
    <!-- Section Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 md:mb-12 gap-4" data-anim="fade-up">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="aura-eyebrow text-color-primary">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-color-heading tracking-tight">
          {{ section.settings.heading | default: 'Shop by Category' }}
        </h2>
      </div>

      {%- if section.settings.show_view_all -%}
        <a
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm uppercase tracking-wider font-semibold text-color-primary hover:text-color-heading transition-colors group"
        >
          {{ section.settings.view_all_label | default: 'View all products' }}
          <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Category Grid / Mobile Scroll-Snap Carousel -->
    <div
      class="flex overflow-x-auto pb-4 pt-1 sm:pb-0 sm:pt-0 snap-x snap-mandatory lg:grid lg:grid-cols-{{ cols_desktop }} gap-4 sm:gap-6 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar"
      data-anim="stagger-children"
      data-anim-stagger="0.08"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign card_title = block.settings.title | default: col.title | default: 'Category'
          assign card_desc = block.settings.text | default: 'Botanical Formulations'
          assign card_link = block.settings.link | default: col.url | default: routes.all_products_collection_url
          assign card_img = block.settings.image | default: col.featured_image
        -%}
        <div
          class="flex-shrink-0 w-[240px] sm:w-[280px] lg:w-auto snap-start"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ card_link }}"
            class="aura-category-card group h-full block text-center"
          >
            <!-- Product Image Cutout Area -->
            <div class="w-full aspect-[4/5] max-h-[220px] sm:max-h-[260px] flex items-center justify-center mb-6 overflow-hidden relative">
              {%- if card_img != blank -%}
                {{ card_img | image_url: width: 600 | image_tag: 
                  loading: 'lazy', 
                  class: 'w-full h-full object-contain p-2 transition-transform duration-500 ease-out group-hover:scale-105' 
                }}
              {%- else -%}
                <div class="w-24 h-40 bg-color-background rounded flex items-center justify-center text-color-primary-accent opacity-60">
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            <!-- Card Label & Subtitle -->
            <div class="w-full flex flex-col items-center">
              <h3 class="aura-eyebrow text-color-heading mb-1 text-sm tracking-[0.18em]">
                {{ card_title }}
              </h3>
              <p class="text-xs text-color-foreground-secondary mb-3 leading-snug">
                {{ card_desc }}
              </p>
              <span class="aura-category-arrow inline-flex items-center justify-center text-color-primary text-sm font-semibold">
                &rarr;
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Botanical Essentials"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Boxed container" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Legacy background color fallback",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom product cutout image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category label",
          "default": "CLEANSERS"
        },
        {
          "type": "text",
          "id": "text",
          "label": "One-line subtext",
          "default": "Purify & refresh"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "CLEANSERS",
            "text": "Purify & refresh"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "SERUMS",
            "text": "Treat & transform"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "MOISTURIZERS",
            "text": "Nourish & protect"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "SUN CARE",
            "text": "Shield & care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
