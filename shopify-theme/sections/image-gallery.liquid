{%- liquid
  assign section_id = 'm-gallery-' | append: section.id
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: 1
-%}

<div id="{{ section_id }}" class="m-section m-gallery py-16" style="background-color: {{ section.settings.bg_color }};">
  <div class="{{ section.settings.container }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center mb-12">
        {%- if section.settings.subheading != blank -%}
          <span class="text-xs uppercase tracking-widest text-[#B9784D] font-medium block mb-2">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="text-3xl md:text-4xl font-serif text-[#18231F]">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="text-sm text-[#5C6B61] max-w-xl mx-auto mt-3">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-{{ columns_mobile }} md:grid-cols-{{ columns_desktop }} gap-6">
      {%- for block in section.blocks -%}
        <div class="m-gallery__item group relative overflow-hidden rounded-lg shadow-sm" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="block w-full h-full">
          {%- endif -%}

          <div class="relative overflow-hidden w-full aspect-{{ section.settings.image_ratio }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: 
                loading: 'lazy', 
                class: 'w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105' 
              }}
            {%- else -%}
              <div class="w-full h-full bg-[#EAE5DF] flex items-center justify-center text-[#9E9589] font-serif text-sm">
                {{ 'image' | placeholder_svg_tag: 'w-16 h-16 opacity-40' }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.caption != blank -%}
              <div class="absolute inset-0 bg-gradient-to-t from-[#18231F]/80 via-transparent to-transparent flex flex-col justify-end p-6 text-white opacity-95 transition-opacity duration-300">
                {%- if block.settings.caption != blank -%}
                  <span class="text-xs uppercase tracking-wider text-[#E2B293] mb-1 font-medium">{{ block.settings.caption }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="text-lg md:text-xl font-serif text-white font-normal">{{ block.settings.title }}</h3>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image gallery",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visual Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Botanical Sanctuaries & Harvests"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A visual exploration of our certified biodynamic gardens and sustainably harvested botanicals."
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Contained" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "[4/5]", "label": "Portrait (4:5)" },
        { "value": "[16/9]", "label": "Landscape (16:9)" }
      ],
      "default": "[4/5]"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FCFBF7"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Camellia Seed Cold-Pressing"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Subtitle / Category",
          "default": "Kyoto Province"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image gallery",
      "blocks": [
        { "type": "image", "settings": { "title": "Cold-Pressed Camellia Oil", "caption": "Artisanal Extraction" } },
        { "type": "image", "settings": { "title": "Wild Bakuchiol Seeds", "caption": "Central Himalayas" } },
        { "type": "image", "settings": { "title": "Bamboo Bio-Fermentation", "caption": "Micro-Filtered Vats" } }
      ]
    }
  ]
}
{% endschema %}

