{%- comment -%}
  KAYRA Beauty v2.0 — Luxury Subscribe & Save Banner Section
  Phase 12 Exact Replica of Reference Design:
  - Wide Container Banner in Warm Terracotta Tint (#CDAA9A / #C6A18F)
  - Left: Unboxing Delivery Box with Wrapped Bottles
  - Right: NEVER RUN LOW / "Subscribe & stay effortlessly consistent" / "Flexible delivery. Pause or cancel anytime." / LEARN MORE Button
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-subscribe-banner-' | append: section.id
  assign container = section.settings.container | default: 'container'
  assign banner_bg = section.settings.bg_color | default: '#C6A18F'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-subscribe-banner py-6 md:py-8 lg:py-10 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 24 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="subscribe-save-banner"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    <div
      class="aura-subscribe-card rounded-none p-6 sm:p-8 md:p-10 lg:p-12 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12 relative overflow-hidden"
      style="background-color: {{ banner_bg }};"
      data-anim="fade-up"
    >
      
      <!-- Left Media Area: Unboxing Package -->
      <div class="w-full md:w-5/12 aspect-[16/10] sm:aspect-[16/9] md:aspect-[4/3] relative rounded-none overflow-hidden group flex items-center justify-center">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: 
            loading: 'lazy', 
            class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105',
            data-anim: 'parallax',
            data-anim-speed: '0.05'
          }}
        {%- else -%}
          <!-- Fallback SVG: Luxury Unboxing Packaging Box with Wrapped Bottles & Dried Floral -->
          <svg class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105" viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Apothecary Subscription Unboxing">
            <defs>
              <linearGradient id="box-outer" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#DAC7BC"/>
                <stop offset="100%" stop-color="#BD9E8E"/>
              </linearGradient>
              <linearGradient id="tissue-pink" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F2DCD3"/>
                <stop offset="100%" stop-color="#E2C2B5"/>
              </linearGradient>
            </defs>
            <!-- Cardboard unboxing container -->
            <path d="M40 70 L280 60 L260 185 L60 195 Z" fill="url(#box-outer)"/>
            <!-- Open Box Flaps -->
            <path d="M40 70 L10 110 L60 195 Z" fill="#AE8F7F" opacity="0.8"/>
            <path d="M280 60 L310 100 L260 185 Z" fill="#B89A8A" opacity="0.9"/>
            <path d="M40 70 L280 60 L240 40 L60 48 Z" fill="#C5AA9B"/>
            <!-- Blush Tissue Paper Fold -->
            <path d="M70 95 C90 70 230 65 245 90 C250 130 235 160 80 165 Z" fill="url(#tissue-pink)"/>
            <!-- Wrapped Bottles inside tissue -->
            <rect x="95" y="105" width="28" height="55" rx="3" fill="#FFFFFF" transform="rotate(-15 95 105)"/>
            <rect x="135" y="98" width="26" height="52" rx="3" fill="#FFFFFF" transform="rotate(5 135 98)"/>
            <rect x="175" y="105" width="30" height="34" rx="4" fill="#FFFFFF" transform="rotate(12 175 105)"/>
            <!-- Minimalist branded box wordmark -->
            <text x="160" y="185" font-family="'Cormorant Garamond', Georgia, serif" font-size="9" font-weight="600" letter-spacing="3" fill="#6B4538" text-anchor="middle">KAYRA BEAUTY</text>
          </svg>
        {%- endif -%}
      </div>

      <!-- Right Content Area -->
      <div class="w-full md:w-7/12 flex flex-col items-start text-left md:pl-4 lg:pl-8">
        {%- if section.settings.eyebrow != blank -%}
          <span class="aura-eyebrow text-[#5E1E16] mb-2 sm:mb-3 text-[11px] uppercase tracking-[0.20em] font-semibold">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="text-2xl sm:text-3xl md:text-[34px] lg:text-[38px] font-serif text-[#5E1E16] mb-3 leading-[1.12] font-medium tracking-tight">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="text-xs sm:text-sm text-[#4A2E25] opacity-90 leading-relaxed mb-6 max-w-md font-normal">
            {{ section.settings.text }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="m-editorial-split__btn-primary !min-w-[170px] !h-[44px] !px-7 !text-xs"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscribe & save banner",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container", "label": "Boxed container (Recommended)" },
        { "value": "container-fluid", "label": "Full width" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Banner background color",
      "default": "#C6A18F"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEVER RUN LOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe & stay effortlessly consistent"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Flexible delivery. Pause or cancel anytime."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Unboxing packaging photo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Subscribe & save banner"
    }
  ]
}
{% endschema %}
