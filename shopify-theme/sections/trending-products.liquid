{%- comment -%}
  KAYRA Beauty v2.0 — Trending Formulations Section
  Showcases trending botanical items with ranked index badges (#01, #02, #03, etc.).
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme
  assign collection = section.settings.collection
  assign product_list = section.settings.product_list
  assign columns = section.settings.columns | default: 4
  assign limit = section.settings.limit | default: 4
  assign show_rank_badges = section.settings.show_rank_badges

  assign items_to_show = product_list
  if items_to_show == blank and collection != blank
    assign items_to_show = collection.products
  endif
-%}

<section
  id="m-trending-products--{{ section.id }}"
  class="m-trending-products m-section m-gradient m-color-{{ color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="trending-products"
>
  <div class="{{ container }} m-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="m-section__header m:text-center m:mb-8 lg:m:mb-12" data-anim="fade-up">
        {%- if section.settings.subheading != blank -%}
          <span class="m:text-xs m:font-bold m:uppercase m:tracking-widest m:text-color-primary m:mb-2 m:block">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="m:text-3xl lg:m:text-4xl m:font-serif m:text-color-heading" data-anim="mask-lines">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="m:grid m:gap-6 md:m:gap-8 m:grid-cols-2 md:m:grid-cols-3 lg:m:grid-cols-{{ columns }}"
      data-anim="stagger-children"
      data-anim-stagger="0.06"
    >
      {%- if items_to_show != blank -%}
        {%- for prod in items_to_show limit: limit -%}
          <div class="m-trending-products__item m:relative" data-anim-child>
            {%- if show_rank_badges -%}
              <div class="m-trending-products__rank-badge m:absolute m:top-3 m:left-3 m:z-10 m:w-8 m:h-8 m:rounded-full m:flex m:items-center m:justify-center m:bg-color-primary m:text-color-primary-text m:font-serif m:font-bold m:text-xs m:shadow-sm">
                #{{ forloop.index }}
              </div>
            {%- endif -%}
            {% render 'product-card', product: prod, index: forloop.index, show_badge: true %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="m-trending-products__item m:relative m:text-center m:p-6 m:bg-color-background-subtle m:rounded-md m:border m:border-color-border" data-anim-child>
            {%- if show_rank_badges -%}
              <div class="m-trending-products__rank-badge m:absolute m:top-3 m:left-3 m:z-10 m:w-8 m:h-8 m:rounded-full m:flex m:items-center m:justify-center m:bg-color-primary m:text-color-primary-text m:font-serif m:font-bold m:text-xs">
                #{{ i }}
              </div>
            {%- endif -%}
            <div class="m-product-card__placeholder m:mb-4" style="height: 280px; background-color: var(--color-aura-border, #E8E1D7); border-radius: var(--aura-radius-sm, 4px);"></div>
            <h3 class="m:text-base m:font-serif m:font-medium">Trending Botanical Formulation {{ i }}</h3>
            <p class="m:text-sm m:text-color-subtext m:mt-1">$92.00</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trending products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Most Coveted Right Now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Botanicals"
    },
    {
      "type": "checkbox",
      "id": "show_rank_badges",
      "label": "Show rank badges (#1, #2...)",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Curated product list",
      "info": "Overrides collection if selected."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Trending products",
      "category": "Products"
    }
  ]
}
{% endschema %}

