{%- liquid
  assign section_id = 'm-faq-' | append: section.id
-%}

<div id="{{ section_id }}" class="m-section m-faq py-16" style="background-color: {{ section.settings.bg_color }};">
  <div class="{{ section.settings.container }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center mb-12">
        {%- if section.settings.subheading != blank -%}
          <span class="text-xs uppercase tracking-widest text-[#B9784D] font-medium block mb-2">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="text-3xl md:text-4xl font-serif text-[#18231F]">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="text-sm text-[#5C6B61] max-w-xl mx-auto mt-3">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="max-w-3xl mx-auto space-y-4">
      {%- for block in section.blocks -%}
        <details class="group border border-[#D9C9B8]/40 rounded-lg bg-white overflow-hidden shadow-xs transition-all duration-300" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none select-none text-[#18231F] font-serif text-lg md:text-xl hover:text-[#B9784D] transition-colors">
            <span class="pr-4">{{ block.settings.question }}</span>
            <span class="transform transition-transform duration-300 group-open:rotate-180 text-[#B9784D] flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-[#5C6B61] leading-relaxed border-t border-[#D9C9B8]/20 pt-4">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find clear answers about our wild-harvested botanicals, clean clinical formulations, and ethical shipping."
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container", "label": "Contained" }
      ],
      "default": "container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FCFBF7"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does bio-fermentation benefit skin barrier health?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Fermentation breaks active plant nutrients into micro-molecules that penetrate lipid bilayers deeper and faster, reducing transepidermal water loss without triggering irritation.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "What skin types are Aura Botanica formulations designed for?",
            "answer": "<p>Our biocompatible formulations are designed for all skin types, including sensitive, reactive, and barrier-compromised skin. Each formula is free of synthetic fragrances, parabens, and aggressive sulfates.</p>",
            "open": true
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you offer complimentary shipping?",
            "answer": "<p>Yes! We offer complimentary carbon-neutral shipping on all domestic orders over $75.00.</p>",
            "open": false
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Are your ingredients certified cruelty-free and vegan?",
            "answer": "<p>Every Aura Botanica formulation is 100% cruelty-free, leaping-bunny compliant, and blended with ethically wildcrafted botanicals.</p>",
            "open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}

