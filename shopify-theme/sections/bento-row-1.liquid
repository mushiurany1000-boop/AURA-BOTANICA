{%- comment -%}
  KAYRA Beauty v2.0 — Bento Row 1 Section
  Phase 12 Exact Replica of Reference Design:
  - Left Card (53.5%): Featured Ritual in Deep Rust (#873223), Serif Title, Outline Button, Bottles Photo.
  - Right Card (45.4%): Ingredient Spotlight in Blush (#F2E6E0), Circular Dish, Squalane, 3 Benefits, Link.
{%- endcomment -%}

{%- liquid
  assign section_id = 'm-bento-row-1-' | append: section.id
  assign container = section.settings.container | default: 'container'
  assign ritual_bg = section.settings.ritual_bg_color | default: '#873223'
  assign ingredient_bg = section.settings.ingredient_bg_color | default: '#F2E6E0'
-%}

<section
  id="{{ section_id }}"
  class="m-section m-bento-row-1 py-8 md:py-12 lg:py-14 relative overflow-hidden"
  style="--section-padding-top: {{ section.settings.padding_top | default: 32 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="bento-row-1"
>
  <div class="{{ container }} max-w-[1240px] mx-auto px-4 sm:px-6">
    <div
      class="grid grid-cols-1 lg:grid-cols-[53.5%_1fr] gap-4 lg:gap-4 items-stretch"
      data-anim="stagger-children"
      data-anim-stagger="0.12"
    >
      
      <!-- Card A: Featured Ritual (Left, 53.5% Deep Rust #873223) -->
      <div
        class="aura-bento-hero--ritual rounded-none p-6 sm:p-8 md:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 relative overflow-hidden group min-h-[340px] sm:min-h-[380px]"
        style="background-color: {{ ritual_bg }};"
        data-anim-child
      >
        <!-- Text Area (Left half of Card A) -->
        <div class="w-full sm:w-1/2 flex flex-col items-start z-10 text-left">
          {%- if section.settings.ritual_eyebrow != blank -%}
            <span class="aura-eyebrow text-[#FCE8E7] opacity-90 mb-2 sm:mb-3 text-[11px] uppercase tracking-[0.20em] font-semibold">
              {{ section.settings.ritual_eyebrow }}
            </span>
          {%- endif -%}

          {%- if section.settings.ritual_heading != blank -%}
            <h3 class="text-2xl sm:text-3xl md:text-[34px] font-serif text-[#FFF7F5] mb-3 leading-[1.12] font-medium tracking-tight">
              {{ section.settings.ritual_heading }}
            </h3>
          {%- endif -%}

          {%- if section.settings.ritual_text != blank -%}
            <p class="text-xs sm:text-sm text-[#FCE8E7] opacity-90 leading-relaxed mb-6 max-w-xs font-normal">
              {{ section.settings.ritual_text }}
            </p>
          {%- endif -%}

          {%- if section.settings.ritual_button_label != blank -%}
            <a
              href="{{ section.settings.ritual_button_link | default: routes.all_products_collection_url }}"
              class="aura-bento-btn--ritual"
            >
              {{ section.settings.ritual_button_label }}
            </a>
          {%- endif -%}
        </div>

        <!-- Image Area (Right half of Card A) -->
        <div class="w-full sm:w-1/2 h-56 sm:h-full min-h-[220px] sm:min-h-[300px] relative overflow-hidden flex items-center justify-end">
          {%- if section.settings.ritual_image != blank -%}
            {{ section.settings.ritual_image | image_url: width: 800 | image_tag: 
              loading: 'lazy', 
              class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105' 
            }}
          {%- else -%}
            <!-- Fallback SVG: Botanical Ritual Trio on Stone Slab with Blossom -->
            <svg class="w-full h-full object-contain" viewBox="0 0 320 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Ritual Formulations">
              <defs>
                <linearGradient id="rit-stone" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#CBB5AA"/>
                  <stop offset="100%" stop-color="#9C8276"/>
                </linearGradient>
                <linearGradient id="rit-copper" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#B87350"/>
                  <stop offset="50%" stop-color="#E2A68F"/>
                  <stop offset="100%" stop-color="#934D2E"/>
                </linearGradient>
              </defs>
              <!-- Stone Slab -->
              <path d="M40 210 L280 200 L270 250 L30 250 Z" fill="url(#rit-stone)"/>
              <path d="M40 210 L280 200 L282 208 L38 218 Z" fill="#EADBD4" opacity="0.6"/>

              <!-- Tall White Pump Cleanser -->
              <rect x="75" y="70" width="48" height="135" rx="5" fill="#FFFFFF"/>
              <rect x="91" y="56" width="16" height="14" rx="2" fill="url(#rit-copper)"/>
              <path d="M96 56 L96 38 L80 40 C76 40 76 35 80 35 L102 33 C105 33 106 35 106 37 L106 56 Z" fill="url(#rit-copper)"/>

              <!-- Dropper Serum Bottle -->
              <rect x="140" y="100" width="38" height="105" rx="5" fill="#F4C7B7" fill-opacity="0.95"/>
              <rect x="149" y="88" width="20" height="12" rx="1.5" fill="url(#rit-copper)"/>
              <path d="M154 88 C154 74 164 74 164 88 Z" fill="#FFFFFF"/>

              <!-- Cream Jar -->
              <rect x="195" y="140" width="62" height="65" rx="6" fill="#FFFFFF"/>
              <rect x="192" y="126" width="68" height="16" rx="3" fill="url(#rit-copper)"/>

              <!-- Delicate Pink Botanical Blossom -->
              <circle cx="58" cy="225" r="9" fill="#E89B8F" fill-opacity="0.85"/>
              <circle cx="70" cy="220" r="8" fill="#E89B8F" fill-opacity="0.85"/>
              <circle cx="68" cy="232" r="8" fill="#E89B8F" fill-opacity="0.85"/>
              <circle cx="56" cy="234" r="7" fill="#E89B8F" fill-opacity="0.85"/>
              <circle cx="64" cy="227" r="3" fill="#FFE8E2"/>
            </svg>
          {%- endif -%}
        </div>
      </div>

      <!-- Card B: Ingredient Spotlight (Right, 45.4% Blush #F2E6E0) -->
      <div
        class="aura-bento-hero--ingredient rounded-none p-6 sm:p-8 md:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 relative overflow-hidden group min-h-[340px] sm:min-h-[380px]"
        style="background-color: {{ ingredient_bg }};"
        data-anim-child
      >
        <!-- Circular Petri Dish Spotlight (Left side of Card B) -->
        <div class="w-full sm:w-[45%] flex items-center justify-center order-2 sm:order-1">
          <div class="aura-circular-spotlight w-36 h-36 sm:w-44 sm:h-44 bg-white relative flex items-center justify-center p-2 border border-[#E9D5CC] shadow-sm">
            {%- if section.settings.ingredient_image != blank -%}
              {{ section.settings.ingredient_image | image_url: width: 600 | image_tag: 
                loading: 'lazy', 
                class: 'w-full h-full object-cover rounded-full transition-transform duration-700 ease-out group-hover:scale-110' 
              }}
            {%- else -%}
              <!-- Fallback SVG: Laboratory Glass Dish with Botanical Petal & Oil Droplets -->
              <svg class="w-full h-full rounded-full transition-transform duration-700 ease-out group-hover:scale-105" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Squalane Spotlight">
                <!-- Outer Glass Rim -->
                <circle cx="80" cy="80" r="76" fill="#FDFBF9" stroke="#E5D6CD" stroke-width="2"/>
                <circle cx="80" cy="80" r="72" stroke="#FFFFFF" stroke-width="1.5"/>
                <!-- Secondary Glass Overlap Dish -->
                <circle cx="60" cy="95" r="28" fill="#FBF4EF" stroke="#E8DACF" stroke-width="1.2" fill-opacity="0.6"/>
                <!-- Botanical Hibiscus / Rose Petal -->
                <path d="M75 55 C90 45 115 55 110 75 C105 92 88 100 78 88 C70 78 65 62 75 55 Z" fill="#E18A80" fill-opacity="0.85"/>
                <path d="M78 58 C88 50 108 58 104 74" stroke="#FFF0ED" stroke-width="1" stroke-linecap="round"/>
                <!-- Pure Squalane Liquid Droplets -->
                <circle cx="95" cy="100" r="8" fill="#FFFFFF" fill-opacity="0.8" stroke="#E2D0C5" stroke-width="0.8"/>
                <circle cx="97" cy="98" r="2" fill="#FFFFFF"/>
                <circle cx="50" cy="70" r="5" fill="#FFFFFF" fill-opacity="0.75" stroke="#E2D0C5" stroke-width="0.8"/>
              </svg>
            {%- endif -%}
          </div>
        </div>

        <!-- Text & 3 Benefit Bullets (Right side of Card B) -->
        <div class="w-full sm:w-[55%] flex flex-col items-start z-10 text-left order-1 sm:order-2">
          {%- if section.settings.ingredient_eyebrow != blank -%}
            <span class="aura-eyebrow text-[#6D514E] mb-2 text-[11px] uppercase tracking-[0.20em] font-semibold">
              {{ section.settings.ingredient_eyebrow }}
            </span>
          {%- endif -%}

          {%- if section.settings.ingredient_heading != blank -%}
            <h3 class="text-2xl sm:text-3xl md:text-[34px] font-serif text-[#5E1E16] mb-3 leading-tight font-medium tracking-tight">
              {{ section.settings.ingredient_heading }}
            </h3>
          {%- endif -%}

          {%- if section.settings.ingredient_benefits != blank -%}
            <div class="text-xs sm:text-sm text-[#6A625F] leading-relaxed mb-5 space-y-1 font-normal">
              {{ section.settings.ingredient_benefits }}
            </div>
          {%- endif -%}

          {%- if section.settings.ingredient_link_label != blank -%}
            <a
              href="{{ section.settings.ingredient_link | default: routes.all_products_collection_url }}"
              class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.16em] font-semibold text-[#5E1E16] hover:text-[#8B3224] transition-colors group/link"
            >
              {{ section.settings.ingredient_link_label }}
              <span class="transition-transform duration-300 group-hover/link:translate-x-1.5 font-sans">&rarr;</span>
            </a>
          {%- endif -%}
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento row 1",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container", "label": "Boxed container (Recommended)" },
        { "value": "container-fluid", "label": "Full width" }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Card A — Featured Ritual (53.5% Width)"
    },
    {
      "type": "color",
      "id": "ritual_bg_color",
      "label": "Ritual card background",
      "default": "#873223"
    },
    {
      "type": "text",
      "id": "ritual_eyebrow",
      "label": "Ritual eyebrow",
      "default": "FEATURED RITUAL"
    },
    {
      "type": "text",
      "id": "ritual_heading",
      "label": "Ritual heading",
      "default": "The Hydration Reset Ritual"
    },
    {
      "type": "textarea",
      "id": "ritual_text",
      "label": "Ritual description",
      "default": "A calming routine to cleanse, hydrate, and restore your natural glow."
    },
    {
      "type": "text",
      "id": "ritual_button_label",
      "label": "Ritual button label",
      "default": "DISCOVER RITUAL"
    },
    {
      "type": "url",
      "id": "ritual_button_link",
      "label": "Ritual button link"
    },
    {
      "type": "image_picker",
      "id": "ritual_image",
      "label": "Ritual photo"
    },
    {
      "type": "header",
      "content": "Card B — Ingredient Spotlight (45.4% Width)"
    },
    {
      "type": "color",
      "id": "ingredient_bg_color",
      "label": "Ingredient card background",
      "default": "#F2E6E0"
    },
    {
      "type": "text",
      "id": "ingredient_eyebrow",
      "label": "Ingredient eyebrow",
      "default": "INGREDIENT SPOTLIGHT"
    },
    {
      "type": "text",
      "id": "ingredient_heading",
      "label": "Ingredient name",
      "default": "Squalane"
    },
    {
      "type": "richtext",
      "id": "ingredient_benefits",
      "label": "Benefit bullet points",
      "default": "<p>Deep moisture.<br>Silky, weightless feel.<br>Barrier support.</p>"
    },
    {
      "type": "text",
      "id": "ingredient_link_label",
      "label": "Ingredient link label",
      "default": "EXPLORE INGREDIENTS"
    },
    {
      "type": "url",
      "id": "ingredient_link",
      "label": "Ingredient link"
    },
    {
      "type": "image_picker",
      "id": "ingredient_image",
      "label": "Circular ingredient photo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Bento row 1"
    }
  ]
}
{% endschema %}
