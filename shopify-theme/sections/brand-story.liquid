{%- comment -%}
  Aura Botanica v2.0 — Brand Story & Founder Editorial Section
  Showcases the botanical skincare brand heritage, founder philosophy, and clinical standards.
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme
  assign image_position = section.settings.image_position
-%}

<section
  id="m-brand-story--{{ section.id }}"
  class="m-brand-story m-section m-gradient m-color-{{ color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="brand-story"
>
  <div class="{{ container }} m-section__inner">
    <div class="m:flex m:flex-wrap m:items-center m:gap-8 lg:m:gap-16{% if image_position == 'right' %} m:flex-row-reverse{% endif %}">
      
      <!-- Visual Column -->
      <div class="m:w-full lg:m:w-5/12 m-brand-story__media-col">
        <div class="m-brand-story__media-wrapper" data-anim="clip-reveal" data-anim-duration="1.1">
          {%- if section.settings.image != blank -%}
            <div class="m-brand-story__image-aspect" style="--aspect-ratio: 4/5;">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'm-brand-story__image m:w-full m:h-full m:object-cover',
                  alt: section.settings.heading
              }}
            </div>
          {%- else -%}
            <div class="m-brand-story__placeholder m:flex m:items-center m:justify-center" style="height: 480px; background-color: var(--color-aura-bg-subtle, #F7F5F0); border: 1px solid var(--color-aura-border, #E8E1D7); border-radius: var(--aura-radius-md, 8px);">
              <div class="m:text-center m:p-8">
                <svg class="m-svg-icon--large m:mx-auto m:mb-4 m:text-color-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                <span class="m:text-sm m:font-medium m:uppercase m:tracking-widest m:text-color-subtle">Botanical Atelier Image</span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.badge_label != blank -%}
            <div class="m-brand-story__floating-badge" data-anim="fade-up" data-anim-delay="0.3">
              <span class="m-brand-story__badge-number">{{ section.settings.badge_value | default: '100%' }}</span>
              <span class="m-brand-story__badge-text">{{ section.settings.badge_label }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Narrative Content Column -->
      <div class="m:w-full lg:m:w-7/12 m-brand-story__text-col">
        <div class="m-brand-story__content" data-anim="fade-up" data-anim-delay="0.15">
          {%- if section.settings.subheading != blank -%}
            <span class="m-brand-story__subheading">{{ section.settings.subheading }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="m-brand-story__heading" data-anim="mask-lines">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.body_text != blank -%}
            <div class="m-brand-story__body rte">
              {{ section.settings.body_text }}
            </div>
          {%- endif -%}

          {%- if section.settings.quote != blank -%}
            <blockquote class="m-brand-story__quote">
              <p>“{{ section.settings.quote }}”</p>
              {%- if section.settings.author_name != blank -%}
                <footer class="m-brand-story__author">
                  <strong>{{ section.settings.author_name }}</strong>
                  {%- if section.settings.author_title != blank -%}
                    <span> — {{ section.settings.author_title }}</span>
                  {%- endif -%}
                </footer>
              {%- endif -%}
            </blockquote>
          {%- endif -%}

          {%- if section.settings.button_text != blank -%}
            <div class="m-brand-story__action m:mt-6">
              <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="m-button m-button--primary" data-magnetic>
                <span>{{ section.settings.button_text }}</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Imagery & Badge"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier image"
    },
    {
      "type": "text",
      "id": "badge_value",
      "label": "Floating badge stat",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Floating badge label",
      "default": "Bio-Active Potency"
    },
    {
      "type": "header",
      "content": "Narrative Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Botanical Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted in Harmony with Nature & Clinical Rigor"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Story text",
      "default": "<p>Born from a profound respect for plant biology, Aura Botanica formulates biocompatible clinical skincare from rare mountain floras, cold-pressed seed oils, and bioactive ferments. Every formulation is bottled in recyclable violet glass to preserve molecular integrity without harsh synthetic stabilizers.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Founder quote",
      "default": "We believe true cellular transformation happens when rare botanicals meet clinical green science."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Dr. Elena Vance"
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Author title",
      "default": "Founder & Lead Phytochemist"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Discover Our Formulation Standards"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}

