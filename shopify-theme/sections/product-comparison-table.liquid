{%- comment -%}
  KAYRA Beauty v2.0 — Formulation Comparison Table Section
  Interactive side-by-side matrix comparing key actives, skin targets, texture, and clinical results.
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme

  assign p1 = section.settings.product_1
  assign p2 = section.settings.product_2
  assign p3 = section.settings.product_3
  assign p4 = section.settings.product_4

  assign active_products_count = 0
  if p1 != blank
    assign active_products_count = active_products_count | plus: 1
  endif
  if p2 != blank
    assign active_products_count = active_products_count | plus: 1
  endif
  if p3 != blank
    assign active_products_count = active_products_count | plus: 1
  endif
  if p4 != blank
    assign active_products_count = active_products_count | plus: 1
  endif

  if active_products_count == 0
    assign active_products_count = 3
  endif
-%}

<section
  id="m-product-comparison--{{ section.id }}"
  class="m-product-comparison m-section m-gradient m-color-{{ color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="product-comparison-table"
>
  <div class="{{ container }} m-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="m-section__header m:text-center m:mb-10 lg:m:mb-14" data-anim="fade-up">
        {%- if section.settings.subheading != blank -%}
          <span class="m:text-xs m:font-bold m:uppercase m:tracking-widest m:text-color-primary m:mb-2 m:block">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="m:text-3xl lg:m:text-4xl m:font-serif m:text-color-heading" data-anim="mask-lines">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="m-comparison-table__wrapper m:overflow-x-auto" data-anim="fade-up" data-anim-delay="0.15">
      <table class="m-comparison-table m:w-full m:border-collapse m:text-left">
        <thead>
          <tr class="m:border-b m:border-color-border">
            <th class="m-comparison-table__th m:p-4 lg:m:p-6 m:w-1/4 m:text-sm m:font-medium m:text-color-subtext">
              Formulation
            </th>

            <!-- Col 1 -->
            <th class="m-comparison-table__th m:p-4 lg:m:p-6 m:w-1/4">
              {%- if p1 != blank -%}
                <div class="m-comparison-table__product-header">
                  {%- if p1.featured_image != blank -%}
                    <div class="m:mb-3 m:w-20 m:h-20 m:mx-auto">
                      {{ p1.featured_image | image_url: width: 200 | image_tag: class: 'm:w-full m:h-full m:object-cover m:rounded', alt: p1.title }}
                    </div>
                  {%- endif -%}
                  <h4 class="m:text-base m:font-serif m:text-center m:mb-1">{{ p1.title }}</h4>
                  <p class="m:text-sm m:text-color-subtext m:text-center m:mb-2">{{ p1.price | money }}</p>
                  <a href="{{ p1.url }}" class="m-button m-button--secondary m:w-full m:text-xs">
                    <span>View Details</span>
                  </a>
                </div>
              {%- else -%}
                <div class="m:text-center m:p-4 m:bg-color-background-subtle m:rounded">
                  <h4 class="m:text-sm m:font-serif">Active Bio-Elixir</h4>
                  <p class="m:text-xs m:text-color-subtext">$84.00</p>
                </div>
              {%- endif -%}
            </th>

            <!-- Col 2 -->
            <th class="m-comparison-table__th m:p-4 lg:m:p-6 m:w-1/4">
              {%- if p2 != blank -%}
                <div class="m-comparison-table__product-header">
                  {%- if p2.featured_image != blank -%}
                    <div class="m:mb-3 m:w-20 m:h-20 m:mx-auto">
                      {{ p2.featured_image | image_url: width: 200 | image_tag: class: 'm:w-full m:h-full m:object-cover m:rounded', alt: p2.title }}
                    </div>
                  {%- endif -%}
                  <h4 class="m:text-base m:font-serif m:text-center m:mb-1">{{ p2.title }}</h4>
                  <p class="m:text-sm m:text-color-subtext m:text-center m:mb-2">{{ p2.price | money }}</p>
                  <a href="{{ p2.url }}" class="m-button m-button--secondary m:w-full m:text-xs">
                    <span>View Details</span>
                  </a>
                </div>
              {%- else -%}
                <div class="m:text-center m:p-4 m:bg-color-background-subtle m:rounded">
                  <h4 class="m:text-sm m:font-serif">Restorative Cream</h4>
                  <p class="m:text-xs m:text-color-subtext">$96.00</p>
                </div>
              {%- endif -%}
            </th>

            <!-- Col 3 -->
            <th class="m-comparison-table__th m:p-4 lg:m:p-6 m:w-1/4">
              {%- if p3 != blank -%}
                <div class="m-comparison-table__product-header">
                  {%- if p3.featured_image != blank -%}
                    <div class="m:mb-3 m:w-20 m:h-20 m:mx-auto">
                      {{ p3.featured_image | image_url: width: 200 | image_tag: class: 'm:w-full m:h-full m:object-cover m:rounded', alt: p3.title }}
                    </div>
                  {%- endif -%}
                  <h4 class="m:text-base m:font-serif m:text-center m:mb-1">{{ p3.title }}</h4>
                  <p class="m:text-sm m:text-color-subtext m:text-center m:mb-2">{{ p3.price | money }}</p>
                  <a href="{{ p3.url }}" class="m-button m-button--secondary m:w-full m:text-xs">
                    <span>View Details</span>
                  </a>
                </div>
              {%- else -%}
                <div class="m:text-center m:p-4 m:bg-color-background-subtle m:rounded">
                  <h4 class="m:text-sm m:font-serif">Phyto-Infusion Mist</h4>
                  <p class="m:text-xs m:text-color-subtext">$58.00</p>
                </div>
              {%- endif -%}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="m:border-b m:border-color-border hover:m:bg-color-background-subtle" {{ block.shopify_attributes }}>
              <td class="m:p-4 lg:m:p-6 m:font-medium m:text-sm m:text-color-heading">
                {{ block.settings.criterion_title }}
              </td>
              <td class="m:p-4 lg:m:p-6 m:text-sm m:text-color-subtext m:text-center">
                {{ block.settings.value_1 }}
              </td>
              <td class="m:p-4 lg:m:p-6 m:text-sm m:text-color-subtext m:text-center">
                {{ block.settings.value_2 }}
              </td>
              <td class="m:p-4 lg:m:p-6 m:text-sm m:text-color-subtext m:text-center">
                {{ block.settings.value_3 }}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product comparison",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find Your Ideal Botanical Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulation Comparison"
    },
    {
      "type": "header",
      "content": "Select Formulations to Compare"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison criterion",
      "settings": [
        {
          "type": "text",
          "id": "criterion_title",
          "label": "Criterion title",
          "default": "Skin Concern Target"
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Product 1 value",
          "default": "Loss of Elasticity & Fine Lines"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Product 2 value",
          "default": "Compromised Barrier & Dryness"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Product 3 value",
          "default": "Dullness & Dehydration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product comparison",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "criterion_title": "Primary Skin Concern",
            "value_1": "Loss of Elasticity & Fine Lines",
            "value_2": "Compromised Barrier & Redness",
            "value_3": "Dehydration & Environmental Stress"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion_title": "Key Botanical Actives",
            "value_1": "Bakuchiol Bio-Retinol + Rosehip",
            "value_2": "Phytosterols + Oat Ceramides",
            "value_3": "Alpine Edelweiss + Camellia Water"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion_title": "Texture & Feel",
            "value_1": "Silky, fast-absorbing botanical nectar",
            "value_2": "Rich velvety barrier cushion",
            "value_3": "Weightless refreshing micro-mist"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion_title": "Ideal Application Time",
            "value_1": "Evening restorative ritual",
            "value_2": "Morning & Evening",
            "value_3": "Throughout day as needed"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "criterion_title": "Clinical Result (4 Weeks)",
            "value_1": "94% noticed firmer skin contour",
            "value_2": "98% reported barrier repair",
            "value_3": "96% instant hydration boost"
          }
        }
      ]
    }
  ]
}
{% endschema %}

