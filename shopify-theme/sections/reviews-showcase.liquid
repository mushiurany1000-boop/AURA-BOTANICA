{%- comment -%}
  KAYRA Beauty v2.0 — Verified Skincare Reviews Showcase Section
  Displays verified customer testimonials with 5-star ratings, skin concern tags, and product links.
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme
  assign columns = section.settings.columns | default: 3
-%}

<section
  id="m-reviews-showcase--{{ section.id }}"
  class="m-reviews-showcase m-section m-gradient m-color-{{ color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="reviews-showcase"
>
  <div class="{{ container }} m-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="m-section__header m:text-center m:mb-10 lg:m:mb-14" data-anim="fade-up">
        {%- if section.settings.subheading != blank -%}
          <span class="m:text-xs m:font-bold m:uppercase m:tracking-widest m:text-color-primary m:mb-2 m:block">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="m:text-3xl lg:m:text-4xl m:font-serif m:text-color-heading" data-anim="mask-lines">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="m:grid m:gap-6 md:m:gap-8 m:grid-cols-1 md:m:grid-cols-2 lg:m:grid-cols-{{ columns }}"
      data-anim="stagger-children"
      data-anim-stagger="0.08"
    >
      {%- for block in section.blocks -%}
        <div
          class="m-review-card m:p-6 lg:m:p-8 m:rounded-md m:border m:border-color-border m:bg-color-background-subtle m:flex m:flex-col m:justify-between m:transition-all hover:m:shadow-md"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <div>
            <!-- Star Rating -->
            <div class="m-review-card__stars m:flex m:items-center m:gap-1 m:mb-4 m:text-color-primary" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- assign rating_num = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <svg class="m-svg-icon--small{% if i <= rating_num %} m:text-color-primary{% else %} m:text-color-border{% endif %}" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {%- endfor -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="m:text-base lg:m:text-lg m:font-serif m:font-semibold m:mb-2 m:text-color-heading">
                “{{ block.settings.title }}”
              </h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="m:text-sm m:text-color-subtext m:leading-relaxed m:mb-4">
                {{ block.settings.body }}
              </p>
            {%- endif -%}
          </div>

          <div class="m-review-card__footer m:pt-4 m:border-t m:border-color-border">
            <div class="m:flex m:items-center m:justify-between m:mb-1">
              <strong class="m:text-sm m:font-medium m:text-color-heading">
                {{ block.settings.author_name | default: 'Verified Customer' }}
              </strong>
              {%- if block.settings.verified_buyer -%}
                <span class="m:inline-flex m:items-center m:text-xs m:font-semibold m:text-color-primary">
                  <svg class="m-svg-icon--small m:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  Verified Ritualist
                </span>
              {%- endif -%}
            </div>

            {%- if block.settings.skin_type != blank -%}
              <span class="m:block m:text-xs m:text-color-subtle">
                Skin Profile: {{ block.settings.skin_type }}
              </span>
            {%- endif -%}

            {%- if block.settings.product != blank -%}
              {%- assign reviewed_prod = block.settings.product -%}
              <a href="{{ reviewed_prod.url }}" class="m:inline-block m:mt-2 m:text-xs m:font-medium m:text-color-primary hover:m:underline">
                Formulation: {{ reviewed_prod.title }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews showcase",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Verified Botanical Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Clinical Rituals"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Customer review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Restored my skin barrier in under 2 weeks"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "After years of struggling with reactive redness and sensitizing acids, this bio-fermented elixir completely transformed my complexion. My skin is calm, dewy, and noticeably resilient."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer name",
          "default": "Clara S."
        },
        {
          "type": "text",
          "id": "skin_type",
          "label": "Customer skin profile",
          "default": "Dry, Sensitive & Barrier Impaired"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Verified ritualist badge",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews showcase",
      "blocks": [
        {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "title": "Restored my skin barrier in under 2 weeks",
            "body": "After years of struggling with reactive redness and sensitizing acids, this bio-fermented elixir completely transformed my complexion. My skin is calm, dewy, and noticeably resilient.",
            "author_name": "Clara S.",
            "skin_type": "Dry, Sensitive & Barrier Impaired",
            "verified_buyer": true
          }
        },
        {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "title": "The most luxurious texture I have ever used",
            "body": "The lipid repair balm melts like spun silk. I wake up with radiant, plump skin that looks like I just walked out of a high-altitude alpine spa.",
            "author_name": "Marcus L.",
            "skin_type": "Combination, Dehydrated",
            "verified_buyer": true
          }
        },
        {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "title": "Clinical results without irritation",
            "body": "The plant-based bakuchiol gives me the exact smoothing of traditional retinol with zero flaking. Truly a masterpiece of green chemistry.",
            "author_name": "Dr. Vivienne R.",
            "skin_type": "Mature, Fine Lines",
            "verified_buyer": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

