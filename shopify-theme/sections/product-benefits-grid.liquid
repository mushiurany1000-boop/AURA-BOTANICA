{%- comment -%}
  Aura Botanica v2.0 — Product Benefits & Clinical Standards Grid
  Modular grid highlighting core botanical skincare efficacy pillars with accessible icons.
{%- endcomment -%}

{%- liquid
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme
  assign columns = section.settings.columns | default: 4
-%}

<section
  id="m-product-benefits--{{ section.id }}"
  class="m-product-benefits m-section m-gradient m-color-{{ color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-section-type="product-benefits-grid"
>
  <div class="{{ container }} m-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="m-section__header m:text-center m:mb-10 lg:m:mb-14" data-anim="fade-up">
        {%- if section.settings.subheading != blank -%}
          <span class="m:text-xs m:font-bold m:uppercase m:tracking-widest m:text-color-primary m:mb-2 m:block">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="m:text-3xl lg:m:text-4xl m:font-serif m:text-color-heading" data-anim="mask-lines">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="m:grid m:gap-6 md:m:gap-8 m:grid-cols-1 md:m:grid-cols-2 lg:m:grid-cols-{{ columns }}"
      data-anim="stagger-children"
      data-anim-stagger="0.08"
    >
      {%- for block in section.blocks -%}
        <div
          class="m-benefit-card m:p-6 lg:m:p-8 m:rounded-md m:border m:border-color-border m:bg-color-background-subtle m:transition-all hover:m:shadow-md"
          data-anim-child
          {{ block.shopify_attributes }}
        >
          <div class="m-benefit-card__icon-wrapper m:w-12 m:h-12 m:rounded-full m:flex m:items-center m:justify-center m:mb-5 m:bg-color-primary-subtle m:text-color-primary">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg class="m-svg-icon--medium" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              {%- when 'droplet' -%}
                <svg class="m-svg-icon--medium" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              {%- when 'flask' -%}
                <svg class="m-svg-icon--medium" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              {%- when 'sparkle' -%}
                <svg class="m-svg-icon--medium" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.286L13 21l-2.286-6.857L5 12l5.714-2.286L13 3z"/>
                </svg>
              {%- else -%}
                <!-- Leaf Icon Default -->
                <svg class="m-svg-icon--medium" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
            {%- endcase -%}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="m:text-lg m:font-serif m:font-semibold m:mb-2 m:text-color-heading">
              {{ block.settings.title }}
            </h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="m:text-sm m:text-color-subtext m:leading-relaxed">
              {{ block.settings.description }}
            </p>
          {%- endif -%}

          {%- if block.settings.pill_tag != blank -%}
            <span class="m:inline-block m:mt-4 m:text-xs m:font-semibold m:text-color-primary m:tracking-wide">
              {{ block.settings.pill_tag }}
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product benefits grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "container-fluid", "label": "Fluid" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clinical Botanical Efficacy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Aura Botanica Standard"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "shield", "label": "Barrier Shield" },
            { "value": "droplet", "label": "Hydration Droplet" },
            { "value": "flask", "label": "Clinical Flask" },
            { "value": "sparkle", "label": "Radiance Sparkle" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Barrier Restoration"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Replenishes skin lipid layers with bio-identical phytosterols, ceramides, and cold-pressed squalane."
        },
        {
          "type": "text",
          "id": "pill_tag",
          "label": "Pill tag",
          "default": "Clinically Proven"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product benefits grid",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Barrier Restoration",
            "description": "Replenishes skin lipid layers with bio-identical phytosterols, ceramides, and cold-pressed squalane.",
            "pill_tag": "Clinical Efficacy"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Wild-Harvested Floras",
            "description": "Sourced at peak potency from high-altitude alpine meadows and biodynamic organic harvests.",
            "pill_tag": "100% Bio-Active"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "flask",
            "title": "Bio-Ferment Precision",
            "description": "Advanced micro-fermentation breaks botanical molecules into hyper-absorbable cellular nutrition.",
            "pill_tag": "Dermatologist Tested"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sparkle",
            "title": "Photoprotective Violet Glass",
            "description": "Bottled in Swiss Miron violet glass to filter degrading ambient light and preserve antioxidant potency.",
            "pill_tag": "Infinite Recyclability"
          }
        }
      ]
    }
  ]
}
{% endschema %}

